{
  "name": "xbt-market",
  "version": "0.1.0",
  "description": "Peer-to-peer marketplace on Nostr, paid in Bitcoin BLAKE2b (BTCB2/XBT) through 2-of-3 multisig escrow with arbiters",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-bookmarklet.mjs && node node_modules/vite/bin/vite.js",
    "build": "node scripts/build-bookmarklet.mjs && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "test": "node scripts/build-bookmarklet.mjs && node --test test/*.test.js",
    "test:regtest": "node test/regtest.integration.mjs",
    "test:e2e": "node test/e2e/trade.e2e.mjs",
    "test:import": "node test/e2e/import.e2e.mjs",
    "test:lightning": "node test/lightning.integration.mjs",
    "test:direct": "node test/e2e/direct.e2e.mjs",
    "test:extras": "node test/e2e/extras.e2e.mjs",
    "test:plan": "node test/e2e/testplan.e2e.mjs",
    "blossom": "node dev/blossom-mock.mjs 3008",
    "proof-report": "node scripts/proof-report.mjs",
    "wallets": "node dev/nwc-mock.mjs",
    "demo": "node scripts/demo.mjs",
    "relay": "node dev/relay.mjs 7777",
    "shim": "node dev/esplora-shim.mjs --port 3006 --rpc http://u:p@127.0.0.1:18443",
    "fixtures": "node test/e2e/shop-fixtures.mjs",
    "service": "node server/node.mjs 8787",
    "service:dev": "SENDCLOUD_BASE=http://127.0.0.1:3011/api/v3 SENDCLOUD_POINTS_BASE=http://127.0.0.1:3011/points SENDCLOUD_PUBLIC_KEY=dev SENDCLOUD_SECRET_KEY=dev PLATFORM_LN_ADDRESS=platform@127.0.0.1:3010 XBT_RATE_EUR=50000 RESEND_BASE=http://127.0.0.1:3011/resend RESEND_API_KEY=dev BUG_REPORT_EMAIL=bugs@example.com ISSUES_TOKEN=dev ISSUES_REPO=test/xbt-market GITHUB_API=http://127.0.0.1:3011/github node server/node.mjs 8787",
    "sendcloud": "node dev/sendcloud-mock.mjs 3011"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "nostr-tools": "^2.25.2",
    "preact": "^11.0.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.12.0",
    "vite": "^8.3.3",
    "ws": "^8.22.0"
  }
}
